{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "GoTap desktop permissions",
  "windows": ["main", "selection", "selection-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "process:allow-exit",
    "process:allow-restart",
    "global-shortcut:default",
    "updater:default"
  ]
}
