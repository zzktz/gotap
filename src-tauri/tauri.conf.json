{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoTap",
  "version": "0.1.13",
  "identifier": "com.zzktz.gotap",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "label": "main", "title": "GoTap", "width": 450, "height": 490, "minWidth": 400, "minHeight": 450, "visible": false, "resizable": true, "center": true, "backgroundColor": "#edf3f8" }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://gotap.123371.com https://gotop.123371.com; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRjA0RjRGNkY0MTI1NDgKUldSSUpVRnZUMC93VW5iQzFGWlVpOW84MmZITTM5Rmg3ck0xV0tFbXFKaXlmdk95Q0J1bVgwcVEK",
      "endpoints": [
        "https://gotap.123371.com/v1/app/update/latest?target={{target}}&arch={{arch}}&current_version={{current_version}}",
        "https://gotop.123371.com/v1/app/update/latest?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ]
    }
  }
}
