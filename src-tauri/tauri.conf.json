{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoTap",
  "version": "0.1.0",
  "identifier": "com.zzktz.gotap",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [{ "label": "main", "title": "GoTap", "width": 520, "height": 680, "minWidth": 460, "minHeight": 600, "visible": false, "resizable": true, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://gotop.123371.com; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    }
  }
}
