#!/bin/sh

# 推送 v2 后调用宝塔 Webhook，由生产服务器自行拉取和部署。
set -u

project_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$project_root" ]; then
    echo "无法确定项目根目录，跳过生产部署。" >&2
    exit 0
fi

local_config="$project_root/.githooks/deploy.local.sh"
if [ -f "$local_config" ]; then
    # 本地配置包含 Webhook 密钥，禁止提交。
    # shellcheck disable=SC1090
    . "$local_config"
fi

remote_name=${1:-}
target_remote=${GOTAP_DEPLOY_REMOTE_NAME:-origin}
target_branch=${GOTAP_DEPLOY_BRANCH:-v2}
webhook_url=${GOTAP_DEPLOY_WEBHOOK_URL:-}
webhook_insecure=${GOTAP_DEPLOY_WEBHOOK_INSECURE:-0}

if [ "$remote_name" != "$target_remote" ]; then
    exit 0
fi

should_deploy=0
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$remote_ref" ] || continue
    if [ "$remote_ref" = "refs/heads/$target_branch" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        should_deploy=1
        break
    fi
done

if [ "$should_deploy" -ne 1 ]; then
    exit 0
fi

if [ -z "$webhook_url" ]; then
    echo "已推送 $target_branch，但未配置宝塔 Webhook 地址。" >&2
    exit 1
fi

echo "已推送 $target_branch，正在调用宝塔 Webhook……"
if [ "$webhook_insecure" = "1" ]; then
    /usr/bin/curl --insecure --fail --silent --show-error --connect-timeout 10 \
        "$webhook_url"
    curl_status=$?
else
    /usr/bin/curl --fail --silent --show-error --connect-timeout 10 \
        "$webhook_url"
    curl_status=$?
fi
if [ "$curl_status" -eq 0 ]; then
    echo "宝塔 Webhook 已接收，服务器将自行拉取并部署。"
else
    echo "宝塔 Webhook 调用失败；代码已推送，请检查宝塔面板和服务器日志。" >&2
    exit 1
fi
